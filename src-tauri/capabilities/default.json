{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and mini agenda windows",
  "windows": ["main", "mini-agenda"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "notification:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    }
  ]
}