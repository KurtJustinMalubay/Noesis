{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noesis",
  "version": "1.4.3",
  "identifier": "noesis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "noesis",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RTdEQzFFNTY0NDgyNTUKUldSVmdrUldIdHpucUJqeEEwT2ovOXNOcDVmYWNDVTdFTzhUdm8xa2xvYkVOU0lNNzlLKzV1dGIK",
      "endpoints": [
        "https://github.com/KurtJustinMalubay/Noesis/releases/latest/download/latest.json"
      ]
    }
  }
}